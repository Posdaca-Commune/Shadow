<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Shadow.Abstractions"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:models="using:Shadow.ParadoxGameLauncher.Models"
             xmlns:vm="using:Shadow.ParadoxGameLauncher.ViewModels"
             x:Class="Shadow.ParadoxGameLauncher.Views.ParadoxSavesSectionView"
             x:Name="SavesSectionRoot"
             x:DataType="vm:ParadoxGameLauncherViewModel">
    <Grid RowDefinitions="Auto,Auto,Auto,*"
          RowSpacing="12">
        <ui:FASettingsExpander Header="{Binding Localizer.Version, Converter={x:Static loc:LocStringConverter.Instance}, ConverterParameter=Paradox.Saves.Content.Header}"
                               Description="{Binding Localizer.Version, Converter={x:Static loc:LocStringConverter.Instance}, ConverterParameter=Paradox.Saves.Content.Description}">
            <ui:FASettingsExpander.IconSource>
                <ui:FASymbolIconSource Symbol="SaveLocal"/>
            </ui:FASettingsExpander.IconSource>
            <ui:FASettingsExpander.Footer>
                <StackPanel Orientation="Horizontal"
                            Spacing="8">
                    <Button Command="{Binding RefreshSavesCommand}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6">
                            <ui:FASymbolIcon Symbol="Sync"/>
                            <TextBlock Text="{Binding Localizer.Version, Converter={x:Static loc:LocStringConverter.Instance}, ConverterParameter=Paradox.Action.Refresh}"/>
                        </StackPanel>
                    </Button>
                    <Button>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6">
                            <ui:FASymbolIcon Symbol="OpenFolder"/>
                            <TextBlock Text="{Binding Localizer.Version, Converter={x:Static loc:LocStringConverter.Instance}, ConverterParameter=Paradox.Action.OpenFolders}"/>
                            <ui:FASymbolIcon Symbol="ChevronDown"
                                             FontSize="10"/>
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MenuItem Header="{Binding Localizer.Version, Converter={x:Static loc:LocStringConverter.Instance}, ConverterParameter=Paradox.Action.OpenSaveFolder}"
                                          Command="{Binding OpenSaveDirectoryCommand}"/>
                                <MenuItem Header="{Binding Localizer.Version, Converter={x:Static loc:LocStringConverter.Instance}, ConverterParameter=Paradox.Action.OpenBackupFolder}"
                                          Command="{Binding OpenSaveBackupDirectoryCommand}"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </ui:FASettingsExpander.Footer>
        </ui:FASettingsExpander>
        <TextBlock Grid.Row="1"
                   Text="{Binding SavesSummaryText}"
                   FontSize="13"
                   Opacity="0.68"/>
        <TextBox Grid.Row="2"
                 PlaceholderText="{Binding Localizer.Version, Converter={x:Static loc:LocStringConverter.Instance}, ConverterParameter=Paradox.Saves.Search.Placeholder}"
                 Text="{Binding SaveSearchText}"
                 MinHeight="36"/>
        <ListBox Grid.Row="3"
                 ItemsSource="{Binding FilteredSaves}"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="0,0,8,0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,2,8"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="CornerRadius" Value="8"/>
                    <Setter Property="ClipToBounds" Value="True"/>
                    <Setter Property="Template">
                        <ControlTemplate>
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </ControlTemplate>
                    </Setter>
                </Style>
            </ListBox.Styles>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:SaveEntry">
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10"
                            Margin="0">
                        <Grid ColumnDefinitions="Auto,*,Auto"
                              MinHeight="56"
                              ColumnSpacing="12">
                            <ui:FASymbolIcon Symbol="SaveLocal"
                                             FontSize="24"
                                             Opacity="0.54"
                                             VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1"
                                        Spacing="4"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal"
                                            Spacing="6">
                                    <Border Background="{DynamicResource ControlFillColorTertiaryBrush}"
                                            CornerRadius="4"
                                            Padding="5,1">
                                        <TextBlock Text="{Binding LastWriteText}"
                                                   FontSize="11"/>
                                    </Border>
                                    <Border Background="{DynamicResource ControlFillColorTertiaryBrush}"
                                            CornerRadius="4"
                                            Padding="5,1">
                                        <TextBlock Text="{Binding SizeText}"
                                                   FontSize="11"/>
                                    </Border>
                                    <Border Background="{DynamicResource ControlFillColorTertiaryBrush}"
                                            CornerRadius="4"
                                            Padding="5,1"
                                            IsVisible="{Binding HasBackups}">
                                        <TextBlock Text="{Binding BackupCountText}"
                                                   FontSize="11"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                <Button Command="{Binding #SavesSectionRoot.((vm:ParadoxGameLauncherViewModel)DataContext).BackupSaveCommand}"
                                        CommandParameter="{Binding}"
                                        Width="34"
                                        Height="34"
                                        Padding="0"
                                        ToolTip.Tip="{Binding #SavesSectionRoot.((vm:ParadoxGameLauncherViewModel)DataContext).Localizer.Version, Converter={x:Static loc:LocStringConverter.Instance}, ConverterParameter=Paradox.Action.BackupSave}">
                                    <ui:FASymbolIcon Symbol="Save"/>
                                </Button>
                                <Button Click="RestoreSaveButton_OnClick"
                                        Width="34"
                                        Height="34"
                                        Padding="0"
                                        ToolTip.Tip="{Binding #SavesSectionRoot.((vm:ParadoxGameLauncherViewModel)DataContext).Localizer.Version, Converter={x:Static loc:LocStringConverter.Instance}, ConverterParameter=Paradox.Action.RestoreSave}">
                                    <ui:FASymbolIcon Symbol="Clock"/>
                                </Button>
                                <Button Click="DeleteSaveButton_OnClick"
                                        Width="34"
                                        Height="34"
                                        Padding="0"
                                        ToolTip.Tip="{Binding #SavesSectionRoot.((vm:ParadoxGameLauncherViewModel)DataContext).Localizer.Version, Converter={x:Static loc:LocStringConverter.Instance}, ConverterParameter=Paradox.Action.Delete}">
                                    <ui:FASymbolIcon Symbol="Delete"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
